{
  "services": [
    {
      "name": "frontend",
      "root": "frontend",
      "framework": "react"
    },
    {
      "name": "backend",
      "root": "backend",
      "entrypoint": "server.js"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
